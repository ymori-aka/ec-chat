# Optional credentials for the pre-declared AI Gateway policies in
# config/policies.json. Only required when an application's policy chain
# selects the matching policy. Configure these as environment variables on
# your Zuplo project (Settings -> Environment Variables) for deployed
# environments.

# --- Akamai Firewall for AI (akamai-ai-firewall-v2-inbound) ---
# Both are required when an application selects this policy.
# Obtain them from Akamai Control Center: create or select a
# Firewall for AI configuration, then issue an API key for it.
AKAMAI_AI_FIREWALL_CONFIGURATION_ID=
AKAMAI_AI_FIREWALL_API_KEY=
